#!/usr/bin/env bash
# OmaStats collector.
#
# Prints one JSON object per interval with CPU, GPU, memory, disk and network
# numbers. Anything this machine cannot report is printed as null instead of a
# fake zero, so the widget can leave it out cleanly.
#
# Usage: omastats [interval] [interface|auto] [mount1,mount2,...]

interval=${1:-2}
iface_pref=${2:-auto}
mounts_raw=${3:-/}

case "$interval" in
  ''|*[!0-9]*) interval=2 ;;
esac
(( interval < 1 )) && interval=1
(( interval > 60 )) && interval=60

hwmon_by_name() {
  local f
  for f in /sys/class/hwmon/hwmon*/name; do
    [[ $(cat "$f" 2>/dev/null) == "$1" ]] && { echo "${f%/name}"; return; }
  done
}

# Temperature input file for the CPU package, or empty if none is found.
find_cpu_temp() {
  local dir label
  for name in k10temp zenpower; do
    dir=$(hwmon_by_name "$name")
    [[ -n $dir && -r $dir/temp1_input ]] && { echo "$dir/temp1_input"; return; }
  done
  dir=$(hwmon_by_name coretemp)
  [[ -z $dir ]] && return
  for label in "$dir"/temp*_label; do
    [[ $(cat "$label" 2>/dev/null) == Package* ]] && { echo "${label%_label}_input"; return; }
  done
  [[ -r $dir/temp1_input ]] && echo "$dir/temp1_input"
}

# The amdgpu device with the most VRAM, so a discrete card wins over an iGPU.
find_amd_gpu() {
  local dev best="" best_vram=-1 vram
  for dev in /sys/class/drm/card*/device; do
    [[ -r $dev/gpu_busy_percent && $(cat "$dev/vendor" 2>/dev/null) == 0x1002 ]] || continue
    vram=$(cat "$dev/mem_info_vram_total" 2>/dev/null || echo 0)
    (( vram > best_vram )) && { best=$dev; best_vram=$vram; }
  done
  echo "$best"
}

resolve_iface() {
  if [[ -n $iface_pref && $iface_pref != auto ]]; then
    echo "$iface_pref"
    return
  fi
  local iface
  iface=$(ip route show default 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
  [[ -z $iface ]] && iface=$(ls /sys/class/net 2>/dev/null | grep -v '^lo$' | head -1)
  echo "$iface"
}

json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/ }
  s=${s//$'\r'/ }
  s=${s//$'\t'/ }
  printf '%s' "$s"
}

# df gives a stable one-line answer for a mount point. Used bytes and total are
# turned into GiB with one decimal so the widget can show a useful tooltip.
disk_json() {
  local first=1 m line pct used total vals
  local -a list
  IFS=',' read -r -a list <<< "$mounts_raw"
  printf '['
  for m in "${list[@]}"; do
    [[ -z $m ]] && continue
    line=$(df -P -B1 -- "$m" 2>/dev/null | tail -1) || continue
    [[ -z $line ]] && continue
    pct=$(awk '{ gsub(/%/, "", $5); print $5 }' <<< "$line" 2>/dev/null)
    used=$(awk '{ print $3 }' <<< "$line" 2>/dev/null)
    total=$(awk '{ print $2 }' <<< "$line" 2>/dev/null)
    [[ $pct =~ ^[0-9]+([.][0-9]+)?$ && $used =~ ^[0-9]+$ && $total =~ ^[0-9]+$ ]] || continue
    vals=$(awk -v u="$used" -v t="$total" 'BEGIN { if (t > 0) printf "%.1f %.1f", u / 1073741824, t / 1073741824; else print "0 0" }')
    (( first )) || printf ','
    first=0
    printf '{"mount":"%s","pct":%s,"used":%s,"total":%s}' \
      "$(json_escape "$m")" "$pct" ${vals% *} ${vals#* }
  done
  printf ']'
}

cpu_temp_file=$(find_cpu_temp)

gpu_kind=${OMASTATS_GPU:-${PASTEL_STATS_GPU:-}}
if [[ -z $gpu_kind ]]; then
  if command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1; then
    gpu_kind=nvidia
  else
    gpu_kind=amd
  fi
fi

amd_dev="" amd_hwmon=""
if [[ $gpu_kind == amd ]]; then
  amd_dev=$(find_amd_gpu)
  [[ -n $amd_dev ]] && amd_hwmon=$(ls -d "$amd_dev"/hwmon/hwmon* 2>/dev/null | head -1)
fi

read_cpu() {
  read -r _ u n s i w q sq st _ < /proc/stat
  idle=$((i + w))
  total=$((u + n + s + i + w + q + sq + st))
}

read_gpu() {
  gpu="-" gtemp="-"
  if [[ $gpu_kind == nvidia ]]; then
    IFS=', ' read -r gpu gtemp < <(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -1)
    [[ $gpu =~ ^[0-9]+$ ]] || gpu="-"
    [[ $gtemp =~ ^[0-9]+$ ]] || gtemp="-"
  elif [[ -n $amd_dev ]]; then
    gpu=$(cat "$amd_dev/gpu_busy_percent" 2>/dev/null || echo "-")
    [[ $gpu =~ ^[0-9]+$ ]] || gpu="-"
    if [[ -n $amd_hwmon && -r $amd_hwmon/temp1_input ]]; then
      gtemp=$(( $(<"$amd_hwmon/temp1_input") / 1000 ))
    fi
  fi
}

read_mem() {
  local key val
  mem_total=0 mem_avail=0 swap_total=0 swap_free=0
  while read -r key val _; do
    case "$key" in
      MemTotal:) mem_total=$val ;;
      MemAvailable:) mem_avail=$val ;;
      SwapTotal:) swap_total=$val ;;
      SwapFree:) swap_free=$val ;;
    esac
  done < /proc/meminfo
  if (( mem_total > 0 )); then
    ram_pct=$(awk -v t="$mem_total" -v a="$mem_avail" 'BEGIN { printf "%.1f", 100 * (t - a) / t }')
    ram_vals=$(awk -v t="$mem_total" -v a="$mem_avail" 'BEGIN { printf "%.1f %.1f", (t - a) / 1048576, t / 1048576 }')
    ram_used=${ram_vals% *}
    ram_total=${ram_vals#* }
  else
    ram_pct=0 ram_used=0 ram_total=0
  fi
  if (( swap_total > 0 )); then
    swap_pct=$(awk -v t="$swap_total" -v f="$swap_free" 'BEGIN { printf "%.1f", 100 * (t - f) / t }')
    swap_vals=$(awk -v t="$swap_total" -v f="$swap_free" 'BEGIN { printf "%.1f %.1f", (t - f) / 1048576, t / 1048576 }')
    swap_used=${swap_vals% *}
    swap_total_gb=${swap_vals#* }
  else
    swap_pct=0 swap_used=0 swap_total_gb=0
  fi
}

now_ns() { date +%s%N; }

iface=$(resolve_iface)
net_rx_file="/sys/class/net/$iface/statistics/rx_bytes"
net_tx_file="/sys/class/net/$iface/statistics/tx_bytes"

read_net() {
  rx=0 tx=0
  [[ -r $net_rx_file ]] && rx=$(<"$net_rx_file")
  [[ -r $net_tx_file ]] && tx=$(<"$net_tx_file")
}

read_cpu
prev_idle=$idle
prev_total=$total
read_gpu
read_mem
read_net
prev_rx=$rx
prev_tx=$tx
prev_time=$(now_ns)

while sleep "$interval"; do
  read_cpu
  dt=$((total - prev_total))
  di=$((idle - prev_idle))
  cpu=$(( dt > 0 ? (100 * (dt - di) + dt / 2) / dt : 0 ))
  prev_idle=$idle
  prev_total=$total

  ctemp="-"
  if [[ -n $cpu_temp_file ]]; then
    cpu_temp_raw=$(cat "$cpu_temp_file" 2>/dev/null)
    [[ $cpu_temp_raw =~ ^[0-9]+$ ]] && ctemp=$(( cpu_temp_raw / 1000 ))
  fi

  read_gpu
  read_mem
  read_net
  now=$(now_ns)
  span=$((now - prev_time))
  rx_rate=$(awk -v a="$rx" -v b="$prev_rx" -v d="$span" 'BEGIN { if (d > 0 && a >= b) printf "%.0f", (a - b) * 1000000000 / d; else print 0 }')
  tx_rate=$(awk -v a="$tx" -v b="$prev_tx" -v d="$span" 'BEGIN { if (d > 0 && a >= b) printf "%.0f", (a - b) * 1000000000 / d; else print 0 }')
  prev_rx=$rx
  prev_tx=$tx
  prev_time=$now

  cpu_json=$cpu
  ctemp_json=null
  [[ $ctemp != "-" ]] && ctemp_json=$ctemp
  gpu_json=null
  [[ $gpu != "-" ]] && gpu_json=$gpu
  gtemp_json=null
  [[ $gtemp != "-" ]] && gtemp_json=$gtemp

  printf '{"cpu":%s,"cpuTemp":%s,"gpu":%s,"gpuTemp":%s,' "$cpu_json" "$ctemp_json" "$gpu_json" "$gtemp_json"
  printf '"ram":%s,"ramUsed":%s,"ramTotal":%s,' "$ram_pct" "$ram_used" "$ram_total"
  printf '"swap":%s,"swapUsed":%s,"swapTotal":%s,' "$swap_pct" "$swap_used" "$swap_total_gb"
  printf '"disks":%s,' "$(disk_json)"
  printf '"iface":"%s","rx":%s,"tx":%s}\n' "$(json_escape "$iface")" "$rx_rate" "$tx_rate"
done
